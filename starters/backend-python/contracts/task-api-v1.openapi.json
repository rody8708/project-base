  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "completed",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Trim surrounding whitespace; reject empty, control characters U+0000..001F/U+007F..009F, U+2028/U+2029, and invalid Unicode. Length counts Unicode code points after trimming."
          },
          "completed": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483646
          }
        },
        "additionalProperties": true
      },
      "Item": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Task"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "data",
          "next_after"
        ],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "next_after": {
            "anyOf": [
              {
                "type": "string",
