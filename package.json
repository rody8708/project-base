{
  "name": "project-foundation-maintenance",
  "private": true,
  "version": "1.1.0-draft.2",
  "license": "MPL-2.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "check": "node scripts/check-repository.mjs && node scripts/check-architecture.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "test": "node --test scripts/*.test.mjs tools/*.test.mjs",
    "web:install": "npm --prefix starters/web ci",
    "web:verify": "npm --prefix starters/web run check",
    "web-vanilla:verify": "npm --prefix starters/web-vanilla run check",
    "web-vanilla:start": "npm --prefix starters/web-vanilla start",
    "backend-node:verify": "npm --prefix starters/backend-node run check",
    "integration:php": "node scripts/test-api-integration.mjs",
    "integration:node": "node scripts/test-node-api-integration.mjs",
    "create-project": "node tools/create-project.mjs"
  }
}
