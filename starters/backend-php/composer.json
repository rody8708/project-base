{
  "name": "foundation/backend-php",
  "description": "An unapproved, replaceable Laravel API foundation for local evaluation.",
  "type": "project",
  "license": "MPL-2.0",
  "require": {
    "php": "~8.5.0",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "laravel/framework": "13.30.1"
  },
  "require-dev": {
    "mockery/mockery": "1.6.15",
    "phpunit/phpunit": "12.5.34"
  },
  "autoload": { "psr-4": { "App\\": "app/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "test": "@php vendor/phpunit/phpunit/phpunit --colors=never",
    "check": ["@php scripts/lint.php", "@test"]
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": false
  },
  "extra": { "foundation-template-revision": "1.1.0-draft.1", "foundation-template-status": "not-approved" },
  "minimum-stability": "stable",
  "prefer-stable": true
}
