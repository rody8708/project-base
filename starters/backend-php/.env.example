APP_NAME="Foundation API example"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_LOCALE=en-US
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# SQLite uses database/database.sqlite when DB_DATABASE is not set.
# For a server database explicitly set DB_HOST, DB_PORT, DB_DATABASE,
# DB_USERNAME and DB_PASSWORD in your private local environment.
